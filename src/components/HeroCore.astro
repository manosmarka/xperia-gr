---
---
<div class="hero-core-wrapper relative w-full h-full flex items-center justify-center">
  <canvas id="hero-core-canvas" class="w-[500px] h-[500px] cursor-grab active:cursor-grabbing"></canvas>
  
  <!-- Subtle center icon overlay -->
  <div class="absolute pointer-events-none">
     <span class="material-symbols-outlined text-white/40 text-4xl font-light">psychology</span>
  </div>
</div>

<script>
  const canvas = document.getElementById('hero-core-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const particles: any[] = [];
    const particleCount = 280;
    const sphereRadius = 160;
    
    // Parallax/Rotation state
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;

    window.addEventListener('mousemove', (e) => {
       const rect = canvas.getBoundingClientRect();
       targetX = (e.clientX - rect.left - rect.width / 2) * 0.005;
       targetY = (e.clientY - rect.top - rect.height / 2) * 0.005;
    });

    class Particle {
      theta: number;
      phi: number;
      distance: number;
      x: number = 0;
      y: number = 0;
      z: number = 0;
      size: number;
      color: string;
      speed: number;
      type: 'dot' | 'dash';

      constructor() {
        this.theta = Math.random() * Math.PI * 2;
        this.phi = Math.acos((Math.random() * 2) - 1);
        this.distance = sphereRadius + (Math.random() * 20 - 10);
        this.size = Math.random() * 2 + 0.5;
        this.speed = Math.random() * 0.01 + 0.005;
        this.type = Math.random() > 0.4 ? 'dot' : 'dash';
        
        // Brand colors for the swarm
        const colors = ['#ffb703', '#fb8500', '#ffffff'];
        this.color = colors[Math.floor(Math.random() * colors.length)];
      }

      update(rotX: number, rotY: number) {
        this.theta += this.speed;
        
        // 3D calculation
        let x = this.distance * Math.sin(this.phi) * Math.cos(this.theta);
        let y = this.distance * Math.sin(this.phi) * Math.sin(this.theta);
        let z = this.distance * Math.cos(this.phi);

        // Rotation logic
        const sinX = Math.sin(rotX);
        const cosX = Math.cos(rotX);
        const sinY = Math.sin(rotY);
        const cosY = Math.cos(rotY);

        // Rotate Y
        let x1 = x * cosY - z * sinY;
        let z1 = x * sinY + z * cosY;
        
        // Rotate X
        let y1 = y * cosX - z1 * sinX;
        let z2 = y * sinX + z1 * cosX;

        this.x = x1;
        this.y = y1;
        this.z = z2;
      }

      draw() {
        if (!ctx) return;
        
        // Perspective scaling
        const scale = 400 / (400 - this.z);
        const posX = this.x * scale + canvas.width / 2;
        const posY = this.y * scale + canvas.height / 2;
        
        ctx.save();
        ctx.translate(posX, posY);
        ctx.globalAlpha = (this.z / sphereRadius + 1) / 2; // Depth fading
        ctx.fillStyle = this.color;
        
        if (this.type === 'dash') {
            ctx.rotate(this.theta);
            ctx.fillRect(-this.size, -this.size * 2, this.size, this.size * 4);
        } else {
            ctx.beginPath();
            ctx.arc(0, 0, this.size * scale, 0, Math.PI * 2);
            ctx.fill();
        }
        
        // Glow effect for orange particles
        if (this.color !== '#ffffff') {
            ctx.shadowBlur = 10;
            ctx.shadowColor = this.color;
        }
        
        ctx.restore();
      }
    }

    function init() {
      canvas.width = 500;
      canvas.height = 500;
      for (let i = 0; i < particleCount; i++) {
        particles.push(new Particle());
      }
    }

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      // Smooth rotation targets
      mouseX += (targetX - mouseX) * 0.05;
      mouseY += (targetY - mouseY) * 0.05;
      
      // Sort for correct depth rendering (Z-sorting)
      particles.sort((a, b) => b.z - a.z);

      for (let p of particles) {
        p.update(mouseY + Date.now() * 0.0001, mouseX + Date.now() * 0.0002);
        p.draw();
      }
      
      // Ambient core glow
      const grad = ctx.createRadialGradient(canvas.width/2, canvas.height/2, 0, canvas.width/2, canvas.height/2, sphereRadius);
      grad.addColorStop(0, 'rgba(251, 133, 0, 0.05)');
      grad.addColorStop(1, 'rgba(251, 133, 0, 0)');
      ctx.fillStyle = grad;
      ctx.fillRect(0,0, canvas.width, canvas.height);
      
      requestAnimationFrame(animate);
    }

    init();
    animate();
  }
</script>

<style>
  #hero-core-canvas {
    filter: drop-shadow(0 0 30px rgba(251, 133, 0, 0.15));
  }
</style>
