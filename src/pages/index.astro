---
import Layout from '../layouts/Layout.astro';
import HeroCore from '../components/HeroCore.astro';
import { workshops as allWorkshops, articles as allArticles, newsItems } from '../data';

const workshops = allWorkshops.slice(0, 3);
---

<Layout title="Xperia | AI Seminars Gateway">
  <!-- Hero Section -->
  <section class="relative min-h-[85vh] flex flex-col items-center justify-center text-center px-6 overflow-hidden bg-white mb-24 transition-all duration-1000">
    <!-- Deep light ambient glow -->
    <div class="absolute inset-0 z-0" style="background: radial-gradient(circle at 50% 50%, rgba(142, 202, 230, 0.08) 0%, rgba(255, 255, 255, 1) 80%);"></div>
    
    <div class="max-w-6xl mx-auto z-10 pt-24 pb-12">
      <div class="mb-10">
        <span id="hero-subtitle" class="text-secondary tracking-[0.4em] uppercase text-[10px] font-black block font-inter antialiased opacity-70 min-h-[1em]"></span>
      </div>
      
      <h1 id="hero-title" class="text-6xl md:text-[6.5rem] font-black leading-[0.95] tracking-[-0.06em] text-on-surface mb-12 font-inter antialiased min-h-[3em]">
          <!-- Typed Content -->
      </h1>

      <!-- Central Generative Core -->
      <div class="reveal-up delay-3 relative w-full max-w-2xl mx-auto h-[400px] mb-20 flex items-center justify-center">
        <HeroCore />
      </div>

<script>
  function typeWriter(elementId: string, text: string, speed: number = 80, delay: number = 0) {
    const element = document.getElementById(elementId);
    if (!element) return;
    
    // Add typing class for cursor
    element.classList.add('typing');
    
    setTimeout(() => {
      let i = 0;
      function type() {
        if (i < text.length) {
          if (text.charAt(i) === '<') {
            const tagEnd = text.indexOf('>', i);
            if (tagEnd !== -1) {
              element!.innerHTML += text.substring(i, tagEnd + 1);
              i = tagEnd + 1;
              setTimeout(type, speed);
              return;
            }
          }
          element!.innerHTML += text.charAt(i);
          i++;
          setTimeout(type, speed);
        } else {
          // Remove cursor after typing
          setTimeout(() => element!.classList.remove('typing'), 1000);
        }
      }
      type();
    }, delay);
  }

  window.addEventListener('DOMContentLoaded', () => {
    const baseDelay = 2300;
    typeWriter('hero-subtitle', 'Intelligence Refined', 100, baseDelay);
    typeWriter('hero-title', 'Master AI for Every<br/> <span class="text-primary italic">Stage of Life</span>', 80, baseDelay + 2200);
  });
</script>

<style>
  .typing::after {
    content: '|';
    display: inline-block;
    margin-left: 4px;
    color: var(--color-primary);
    animation: blink 0.8s infinite;
    font-weight: 200;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>

      <div class="reveal-up delay-4 flex flex-col md:flex-row gap-8 justify-center items-center">
        <a href="/workshops" class="group relative px-14 py-6 bg-on-surface text-background rounded-full font-black text-xs uppercase tracking-[0.2em] hover:bg-primary hover:shadow-[0_25px_50px_-12px_rgba(251,133,0,0.4)] transition-all duration-500 active:scale-95 overflow-hidden">
          <span class="relative z-10">Initialize Learning</span>
          <div class="absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
        </a>
        <a href="/workshops" class="px-14 py-6 bg-transparent border border-outline-variant/40 text-on-surface/60 rounded-full font-black text-xs uppercase tracking-[0.2em] hover:text-on-surface hover:border-on-surface transition-all duration-500 active:scale-95">
          System Overview
        </a>
      </div>
    </div>
  </section>

  <!-- Paths (Primary Content Area) -->
  <section class="py-16 md:px-12 max-w-[1440px] mx-auto w-full mb-24 relative z-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- For Kids -->
      <a href="/kids" class="group relative p-10 rounded-2xl bg-white border border-outline-variant/40 hover:border-secondary transition-all duration-500 overflow-hidden block shadow-[0_32px_64px_-16px_rgba(0,0,0,0.05)]">
        <div class="relative z-10 h-full flex flex-col">
          <div class="w-16 h-16 rounded-2xl bg-secondary-container/30 flex items-center justify-center mb-10 transition-transform group-hover:scale-110">
            <span class="material-symbols-outlined text-secondary text-3xl">child_care</span>
          </div>
          <h3 class="text-2xl font-bold text-on-surface mb-4 tracking-tight">For Kids</h3>
          <p class="text-on-surface-variant leading-relaxed mb-12">Interactive, gamified AI learning paths designed to foster curiosity and foundational ethics in the next generation.</p>
          <div class="mt-auto flex items-center gap-2 text-secondary font-bold group-hover:translate-x-2 transition-transform">
            <span class="text-sm">Explore Gamified AI</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </div>
        </div>
      </a>

      <!-- For Adults -->
      <a href="/workshops" class="group relative p-10 rounded-2xl bg-white border border-outline-variant/40 hover:border-primary transition-all duration-500 overflow-hidden md:scale-105 z-10 shadow-[0_45px_80px_-20px_rgba(0,0,0,0.08)] block">
        <div class="relative z-10 h-full flex flex-col">
          <div class="w-16 h-16 rounded-2xl bg-primary-container/30 flex items-center justify-center mb-10 transition-transform group-hover:scale-110">
            <span class="material-symbols-outlined text-primary text-3xl">psychology</span>
          </div>
          <h3 class="text-2xl font-bold text-on-surface mb-4 tracking-tight">For Adults</h3>
          <p class="text-on-surface-variant leading-relaxed mb-12">Sleek, career-focused mastery programs. Transition your workflow into the age of AI with professional-grade tools.</p>
          <div class="mt-auto flex items-center gap-2 text-primary font-bold group-hover:translate-x-2 transition-transform">
            <span class="text-sm">Elevate Your Career</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </div>
        </div>
      </a>

      <!-- For Small Business -->
      <a href="/workshops" class="group relative p-10 rounded-2xl bg-white border border-outline-variant/40 hover:border-secondary transition-all duration-500 overflow-hidden block shadow-[0_32px_64px_-16px_rgba(0,0,0,0.05)]">
        <div class="relative z-10 h-full flex flex-col">
          <div class="w-16 h-16 rounded-2xl bg-secondary-container/20 flex items-center justify-center mb-10 transition-transform group-hover:scale-110">
            <span class="material-symbols-outlined text-secondary text-3xl">insights</span>
          </div>
          <h3 class="text-2xl font-bold text-on-surface mb-4 tracking-tight">Small Business</h3>
          <p class="text-on-surface-variant leading-relaxed mb-12">Analytics and growth-focused seminars. Automate operations and leverage data to scale your vision efficiently.</p>
          <div class="mt-auto flex items-center gap-2 text-secondary font-bold group-hover:translate-x-2 transition-transform">
            <span class="text-sm">Analyze Growth</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- 4D AI Fluency Bar -->
  <section class="py-24 bg-surface-container-low/50 -mx-4 px-4 w-[calc(100%+2rem)] mb-24 overflow-hidden">
    <div class="max-w-[1440px] mx-auto px-4 md:px-12">
      <p class="text-center text-on-surface-variant/60 font-black tracking-[0.25em] uppercase text-[10px] mb-12">The 4D AI Fluency Framework</p>
      <div class="flex flex-wrap justify-center items-center gap-12 md:gap-24 opacity-60 grayscale hover:grayscale-0 transition-all duration-700">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-3xl">assignment_turned_in</span>
          <span class="font-bold text-xl tracking-tighter text-on-surface uppercase">Delegation</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-3xl">chat_bubble</span>
          <span class="font-bold text-xl tracking-tighter text-on-surface uppercase">Description</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-3xl">visibility</span>
          <span class="font-bold text-xl tracking-tighter text-on-surface uppercase">Discernment</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-3xl">verified_user</span>
          <span class="font-bold text-xl tracking-tighter text-on-surface uppercase">Diligence</span>
        </div>
      </div>
    </div>
  </section>

  <!-- The Seminar Glass Blade -->
  <section class="pb-32 px-4 md:px-12 max-w-[1440px] mx-auto w-full overflow-hidden">
    <div class="flex justify-between items-end mb-12">
      <h2 class="text-4xl font-black tracking-tight text-on-surface">Upcoming Seminars</h2>
      <a href="/workshops" class="text-primary hover:text-secondary font-bold transition-colors">View all</a>
    </div>
    
    <div class="space-y-4">
      {workshops.map((w: any, index: number) => {
        const isFirst = index === 0;
        const borderColor = isFirst ? 'border-primary' : 'border-outline-variant/30';
        const dateColor = isFirst ? 'text-primary' : 'text-on-surface-variant/60';
        const dateString = w.startDateTime ? new Date(w.startDateTime).toLocaleDateString('en-US', { month: 'short', day: '2-digit' }).toUpperCase() : 'TBA';
        
        return (
          <div class={`flex flex-col md:flex-row items-center justify-between p-10 rounded-2xl bg-white border border-outline-variant/30 border-l-4 ${borderColor} hover:shadow-[0_10px_30px_-10px_rgba(0,0,0,0.05)] transition-all duration-400 group`}>
            <div class="flex items-start md:items-center gap-10 mb-6 md:mb-0 w-full md:w-auto">
              <div class={`${dateColor} font-bold text-xs tracking-widest w-16 shrink-0`}>{dateString}</div>
              <div>
                <h4 class="text-2xl font-bold mb-2 group-hover:text-primary transition-colors text-on-surface">{w.eventName}</h4>
                <p class="text-on-surface-variant max-w-lg">{w.summary}</p>
              </div>
            </div>
            <a href={w.bookingUrl || '/workshops'} target="_blank" class="w-full md:w-auto text-center px-10 py-4 rounded-full bg-on-surface text-white hover:bg-primary font-bold transition-all duration-400 shrink-0">
              Reserve Seat
            </a>
          </div>
        )
      })}

      {workshops.length === 0 && (
         <div class="text-on-surface-variant font-mono border border-dashed border-outline-variant/30 p-12 rounded-2xl text-center shadow-inner">No active seminars available at this time.</div>
      )}
    </div>
  </section>
</Layout>
