---
import Layout from '../../layouts/Layout.astro';
import { workshops } from '../../data';
---

<Layout 
  title="Σεμινάρια - Xperia.gr" 
  description="Εξερευνήστε πρακτικά σεμινάρια και εργαστήρια ΤΝ σχεδιασμένα για την Ελλάδα."
>
  <div class="px-6 md:px-12 max-w-[1440px] mx-auto pt-24 pb-32">
    <div class="mb-20 text-center max-w-3xl mx-auto">
       <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/5 border border-primary/10 mb-8">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="text-primary text-[10px] font-black tracking-widest uppercase">Ζωντανές Συνεδρίες</span>
      </div>
      <h1 class="text-5xl md:text-6xl font-black mb-6 font-inter text-on-surface tracking-tight">ΤΝ για <span class="text-primary italic">Επαγγελματίες</span></h1>
      <p class="text-on-surface-variant text-lg leading-relaxed">Επαγγελματικά, άμεσα εφαρμόσιμα σεμινάρια σχεδιασμένα να επιταχύνουν τη ροή εργασίας σας και να ενσωματώσουν την ευφυΐα στην επιχείρησή σας.</p>
    </div>

    {workshops.length === 0 && (
      <div class="text-on-surface-variant font-mono border border-dashed border-outline-variant/30 p-16 rounded-3xl text-center bg-surface-container-low/30 shadow-inner">Δεν υπάρχουν διαθέσιμα σεμινάρια αυτή τη στιγμή.</div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      {workshops.map((w: any) => {
        const title = w.eventNameEl || w.eventName;
        const summary = w.summaryEl || w.summary;
        const difficulty = w.difficultyEl || w.difficulty;
        
        return (
          <article class="bg-white border border-outline-variant/40 rounded-[2.5rem] p-12 flex flex-col gap-8 hover:shadow-[0_32px_64px_-16px_rgba(0,0,0,0.05)] hover:-translate-y-1 transition-all duration-500 group">
            <header class="flex flex-col gap-4">
               <div class="flex justify-between items-start">
                 {difficulty && (
                  <span class="text-[10px] px-3 py-1 rounded-full bg-primary-container/30 text-primary font-black tracking-widest uppercase">
                    {difficulty}
                  </span>
                 )}
              </div>
              <h2 class="text-3xl font-bold text-on-surface group-hover:text-primary transition-colors tracking-tight leading-tight">{title}</h2>
            </header>

            {summary && (
              <p class="text-on-surface-variant text-base leading-relaxed">{summary}</p>
            )}

            <div class="flex flex-wrap gap-8 py-8 border-y border-outline-variant/10 text-xs font-black uppercase tracking-[0.1em] text-on-surface-variant/70">
              {w.onRequest && (
                <div class="flex items-center gap-3">
                  <span class="material-symbols-outlined text-[20px] text-primary">calendar_clock</span>
                  <span>Κατόπιν ζήτησης</span>
                </div>
              )}
              {!w.onRequest && w.startDateTime && (
                <div class="flex items-center gap-3">
                  <span class="material-symbols-outlined text-[20px] text-primary">event</span>
                  <span>{new Date(w.startDateTime).toLocaleDateString('el-GR', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
                </div>
              )}
              {w.location && (
                <div class="flex items-center gap-3">
                  <span class="material-symbols-outlined text-[20px] text-primary">location_on</span>
                  <span>{w.location}</span>
                </div>
              )}
              {typeof w.price === 'number' && (
                 <div class="flex items-center gap-3 text-on-surface font-bold">
                  <span class="material-symbols-outlined text-[20px] text-primary">sell</span>
                  <span>€{w.price.toFixed(2)}</span>
                </div>
              )}
            </div>

            {w.bookingUrl && (
              <div class="mt-auto">
                 <a
                  href={w.bookingUrl}
                  class="w-full text-center block px-8 py-4 rounded-full bg-on-surface text-white font-black uppercase tracking-widest text-sm hover:bg-primary transition-all duration-400 active:scale-95 shadow-md hover:shadow-xl"
                  target="_blank"
                  rel="noreferrer"
                >
                  Κράτηση Θέσης
                </a>
              </div>
            )}
          </article>
        )
      })}
    </div>
  </div>
</Layout>
