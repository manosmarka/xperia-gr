---
import Layout from '../../layouts/Layout.astro';
import { kidsResources as resources } from '../../data';
---

<Layout title="ΤΝ για Παιδιά - Xperia.gr">
  <div class="px-6 md:px-12 max-w-[1440px] mx-auto pt-24 pb-32">
    <div class="mb-20 text-center max-w-3xl mx-auto">
      <span class="text-secondary tracking-[0.25em] uppercase text-[10px] font-black mb-6 block font-inter antialiased">Μικροί Εξερευνητές</span>
      <h1 class="text-5xl md:text-6xl font-black mb-6 font-inter text-on-surface tracking-tight">ΤΝ για <span class="text-secondary italic">Παιδιά</span></h1>
      <p class="text-on-surface-variant text-lg leading-relaxed">Διαδραστικά, παιχνιδιοποιημένα μονοπάτια μάθησης σχεδιασμένα να καλλιεργούν την περιέργεια, τη δεοντολογία και την αυτοπεποίθηση στην επόμενη γενιά.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {resources.map((r: any) => {
        const title = r.titleEl || r.title;
        const safety = r.safetyNoteEl || r.safetyNote;
        
        return (
          <article class="bg-white border border-outline-variant/40 rounded-[2rem] p-10 flex flex-col gap-6 hover:shadow-[0_32px_64px_-16px_rgba(0,0,0,0.05)] hover:-translate-y-1 transition-all duration-500 group">
            <header class="flex flex-col gap-4">
              <div class="flex justify-between items-start">
                {r.ageGroup && (
                  <span class="text-[10px] px-3 py-1 rounded-full bg-secondary-container/30 text-secondary font-black tracking-widest uppercase shrink-0">
                    Ηλικίες {r.ageGroup}
                  </span>
                )}
              </div>
              <h2 class="text-2xl font-bold text-on-surface group-hover:text-secondary transition-colors tracking-tight leading-tight">{title}</h2>
            </header>

            {safety && (
              <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant/20">
                <p class="text-xs text-on-surface-variant leading-relaxed">
                  <span class="font-black uppercase tracking-widest text-[9px] block mb-1 scale-95 origin-left">Προτεραιότητα Ασφάλειας:</span> 
                  {safety}
                </p>
              </div>
            )}

            <div class="mt-auto pt-6">
               {r.videoUrl && (
                <a
                  href={r.videoUrl}
                  class="inline-flex items-center gap-2 text-primary hover:text-secondary text-sm font-black uppercase tracking-widest transition-colors scale-95 origin-left"
                  target="_blank"
                  rel="noreferrer"
                >
                  <span class="material-symbols-outlined text-lg">play_circle</span>
                  Δείτε τη Δραστηριότητα
                </a>
              )}
            </div>
          </article>
        )
      })}
    </div>
  </div>
</Layout>
