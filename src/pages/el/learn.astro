---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data';
---

<Layout title="Μάθετε ΤΝ - Xperia.gr">
  <div class="px-6 md:px-12 max-w-[1440px] mx-auto pt-24 pb-32">
    <div class="mb-20 text-center max-w-3xl mx-auto">
      <span class="text-primary tracking-[0.25em] uppercase text-[10px] font-black mb-6 block font-inter antialiased">Κέντρο Γνώσης</span>
      <h1 class="text-5xl md:text-6xl font-black mb-6 font-inter text-on-surface tracking-tight">Εκπαίδευση <span class="text-primary italic">ΤΝ</span></h1>
      <p class="text-on-surface-variant text-lg leading-relaxed">Εμπεριστατωμένα άρθρα, πρακτικά σεμινάρια και οδηγοί για να σας βοηθήσουν να κατανοήσετε την επανάσταση της τεχνητής νοημοσύνης.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {articles.length === 0 && <div class="text-on-surface-variant font-mono border border-dashed border-outline-variant/30 p-16 rounded-3xl text-center bg-surface-container-low/30 col-span-full">Δεν βρέθηκαν άρθρα αυτή τη στιγμή.</div>}

      {articles.map((post: any) => {
        const title = post.titleEl || post.title;
        
        return (
          <article class="bg-white rounded-[2rem] overflow-hidden border border-outline-variant/40 hover:border-primary/50 transition-all duration-500 group hover:-translate-y-2 hover:shadow-[0_32px_64px_-16px_rgba(0,0,0,0.08)] flex flex-col">
            {post.imageUrl && (
              <div class="aspect-video overflow-hidden">
                  <img 
                  src={post.imageUrl} 
                  alt={title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  />
              </div>
            )}
            <div class="p-10 flex flex-col flex-1">
              <p class="text-[10px] text-on-surface-variant/60 mb-4 font-black tracking-widest uppercase">
                {new Date(post.publishedAt).toLocaleDateString('el-GR', { month: 'long', day: 'numeric', year: 'numeric' })}
              </p>
              <h2 class="text-2xl font-bold mb-6 text-on-surface group-hover:text-primary transition-colors tracking-tight leading-tight">{title}</h2>
              <div class="mt-auto pt-4 flex">
                  <a 
                  href={`/el/learn/${post.slug}`} 
                  class="inline-flex items-center gap-2 text-primary hover:text-secondary text-xs font-black uppercase tracking-widest transition-colors scale-95 origin-left"
                  >
                  Διαβάστε το Άρθρο <span class="material-symbols-outlined text-sm">arrow_forward</span>
                  </a>
              </div>
            </div>
          </article>
        )
      })}
    </div>
  </div>
</Layout>
