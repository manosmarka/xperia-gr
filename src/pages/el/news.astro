---
import Layout from '../../layouts/Layout.astro';
import { newsItems as items } from '../../data';
---

<Layout title="Νέα - Xperia.gr">
  <div class="px-6 md:px-12 max-w-[1440px] mx-auto pt-24 pb-32">
    <div class="mb-20 text-center max-w-3xl mx-auto">
      <span class="text-secondary tracking-[0.25em] uppercase text-[10px] font-black mb-6 block font-inter antialiased">Σήματα & Ενοράσεις</span>
      <h1 class="text-5xl md:text-6xl font-black mb-6 font-inter text-on-surface tracking-tight">Κέντρο <span class="text-secondary italic">Νέων ΤΝ</span></h1>
      <p class="text-on-surface-variant text-lg leading-relaxed">Μείνετε ενημερωμένοι με τις τελευταίες ανακαλύψεις, τις ρυθμιστικές αλλαγές και τα απαραίτητα σήματα ΤΝ από όλο τον κόσμο.</p>
    </div>

    {items.length === 0 && (
      <div class="text-on-surface-variant font-mono border border-dashed border-outline-variant/30 p-16 rounded-3xl text-center bg-surface-container-low/30 shadow-inner">Δεν υπάρχουν νέα διαθέσιμα αυτή τη στιγμή.</div>
    )}

    <div class="space-y-6 max-w-4xl mx-auto">
      {items.map((item: any) => {
        const headline = item.headlineEl || item.headline;
        const summary = item.summaryEl || item.summary;
        
        return (
          <article class="bg-white border border-outline-variant/30 rounded-3xl p-8 flex flex-col gap-4 hover:shadow-[0_20px_40px_-20px_rgba(0,0,0,0.1)] transition-all duration-500 group">
            <header class="flex flex-col md:flex-row md:items-center justify-between gap-4">
              <h2 class="text-xl font-bold text-on-surface group-hover:text-primary transition-colors tracking-tight">{headline}</h2>
              {item.date && (
                <time class="text-[10px] text-on-surface-variant/50 font-black tracking-widest uppercase shrink-0">{new Date(item.date).toLocaleDateString('el-GR', { month: 'short', day: '2-digit', year: 'numeric' })}</time>
              )}
            </header>

            {summary && (
              <p class="text-on-surface-variant leading-relaxed text-sm">{summary}</p>
            )}

            <div class="flex flex-wrap items-center justify-between gap-6 mt-4 pt-6 border-t border-outline-variant/10">
              <div class="flex flex-wrap items-center gap-4">
                {item.sourceName && (
                  <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-on-surface-variant/60">
                    <span class="material-symbols-outlined text-[16px] text-secondary">link</span>
                    {item.sourceUrl ? (
                      <a href={item.sourceUrl} class="text-secondary hover:text-primary transition-colors" target="_blank" rel="noreferrer">{item.sourceName}</a>
                    ) : (
                      item.sourceName
                    )}
                  </div>
                )}
              </div>
              
              {item.tags && item.tags.length > 0 && (
                <div class="flex gap-2">
                  {item.tags.map((t: string) => (
                      <span class="px-2 py-0.5 rounded-md bg-secondary-container/20 text-secondary text-[9px] font-black uppercase tracking-widest leading-none flex items-center justify-center">{t}</span>
                  ))}
                </div>
              )}
            </div>
          </article>
        )
      })}
    </div>
  </div>
</Layout>
